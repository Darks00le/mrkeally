<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Recursive Chaos Engine</title>
    <style>
        body, html { margin: 0; padding: 0; width: 100%; height: 100%; background: #000; overflow: hidden; }
        canvas { display: block; }
        #ui { position: absolute; top: 20px; left: 20px; color: #fff; font-family: monospace; pointer-events: none; opacity: 0.5; }
    </style>
</head>
<body>
    <div id="ui">SYSTEM_FRACTAL_V0.1 // RUNNING</div>
    <canvas id="canvas"></canvas>

    <script>
        const canvas = document.getElementById('canvas');
        const ctx = canvas.getContext('2d');
        let width, height, points, colors;

        function init() {
            width = canvas.width = window.innerWidth;
            height = canvas.height = window.innerHeight;
            // Define the vertices of a triangle for the Chaos Game
            points = [
                {x: width / 2, y: 50},
                {x: 50, y: height - 50},
                {x: width - 50, y: height - 50}
            ];
            ctx.fillStyle = '#000';
            ctx.fillRect(0, 0, width, height);
        }

        let current = {x: Math.random() * width, y: Math.random() * height};
        
        function draw() {
            // Draw 100 points per frame for performance and "growth" effect
            for (let i = 0; i < 100; i++) {
                const target = points[Math.floor(Math.random() * points.length)];
                current.x = (current.x + target.x) / 2;
                current.y = (current.y + target.y) / 2;
                
                // Color mapping based on position
                const hue = (current.x / width) * 360;
                ctx.fillStyle = `hsl(${hue}, 80%, 50%)`;
                ctx.fillRect(current.x, current.y, 1, 1);
            }
            requestAnimationFrame(draw);
        }

        window.addEventListener('resize', init);
        init();
        draw();
    </script>
</body>
</html>
